{
  "name": "@erme2/feature-flag-evaluator",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feature-flag-evaluator.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.lib.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src demo e2e scripts .github *.md *.json *.ts index.html",
    "format:check": "prettier --check src demo e2e scripts .github *.md *.json *.ts index.html",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "description": "An unstyled React widget for editing and evaluating feature flag rules.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erme2/feature-flag-evaluator.git"
  },
  "homepage": "https://github.com/erme2/feature-flag-evaluator#readme",
  "bugs": {
    "url": "https://github.com/erme2/feature-flag-evaluator/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
